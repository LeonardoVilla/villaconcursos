# Active somente depois de configurar as variáveis abaixo.
AUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# restricted: somente os e-mails abaixo. public: qualquer conta Google verificada.
AUTH_ACCESS_MODE=restricted
AUTH_ALLOWED_EMAILS=
