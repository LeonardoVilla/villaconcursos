# Modelo das variáveis de ambiente. Copie para .env.local e preencha. Nunca versione valores reais.

# --- Login com Google (opcional) ---
# O login só é exigido quando AUTH_ENABLED=true.
AUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# restricted: somente os e-mails abaixo. public: qualquer conta Google verificada.
AUTH_ACCESS_MODE=restricted
AUTH_ALLOWED_EMAILS=

# --- Banco Neon Postgres (sincronização do progresso entre aparelhos) ---
# Preenchidas por `neon env pull`. Sem DATABASE_URL, o app funciona só com o progresso local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# --- APIs de IA (opcional; usadas só no servidor, nunca expostas ao navegador) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Escolha dos modelos de IA (troque aqui, sem mexer no código) ---
# provedor: openai ou deepseek. Os nomes dos modelos devem existir na sua conta.
AI_EXPLAIN_PROVIDER=openai
AI_EXPLAIN_MODEL=gpt-5.4-nano
AI_ESSAY_PROVIDER=openai
AI_ESSAY_MODEL=gpt-5.4-mini
AI_FALLBACK_PROVIDER=deepseek
AI_FALLBACK_MODEL=deepseek-flash
# limite de usos de IA por pessoa por dia (controle de custo)
AI_DAILY_LIMIT=30
